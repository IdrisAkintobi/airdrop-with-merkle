{
  "name": "airdrop-proof",
  "version": "0.0.1",
  "description": "A project that shows the implementing of airdrop using merkle tree for address whitelisting",
  "main": "main.js",
  "scripts": {
    "build": "npm run format && npx hardhat compile",
    "test": "npm run build && REPORT_GAS=true npx hardhat test",
    "format": "prettier --write --ignore-path .gitignore .",
    "deploy:MerkleAirdrop": "npm run test && npx hardhat ignition deploy ./ignition/modules/MerkleAirdrop.ts --network lisk-sepolia --verify",
    "script:MerkleAirdrop": "npx hardhat run scripts/MerkleAirdrop.interaction.ts",
    "script:MerkleAirdropV2": "npx hardhat run scripts/MerkleAirdropV2.interaction.ts --network localhost",
    "start:local:node": "npx hardhat node",
    "deploy:local:MerkleAirdrop": "npx hardhat ignition deploy ./ignition/modules/MerkleAirdrop.ts --network localhost",
    "deploy:local:MerkleAirdropV2": "npx hardhat ignition deploy ./ignition/modules/MerkleAirdropV2.ts --network lisk-sepolia",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdrisAkintobi/airdrop-with-merkle.git"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "airdrop",
    "merkle-tree"
  ],
  "author": "IdrisAkintobi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IdrisAkintobi/airdrop-with-merkle/issues"
  },
  "homepage": "https://github.com/IdrisAkintobi/airdrop-with-merkle#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "csv-parse": "^5.5.6",
    "ethers": "^6.13.2",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.4.0"
  }
}
